[Unit]
Description=Pirrot flip counter (time since last commit, SVG)
After=network-online.target
Wants=network-online.target

[Service]
User=kacper
ExecStart=/usr/bin/python3 /home/kacper/pirrot-counter/server.py
Environment=HOST=127.0.0.1 PORT=8787 GITHUB_USER=masluny
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target
